# Clinik_app - public/.htaccess
# Front Controller: todas las peticiones van a index.php

<IfModule mod_rewrite.c>
    Options -Indexes
    RewriteEngine On
    RewriteBase /clinik_app/public/

    # Servir archivos y carpetas fisicas directamente (assets, css, js)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Todo lo demas va al Front Controller
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# Cabeceras de seguridad basicas
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
</IfModule>
